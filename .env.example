APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./wisense.db
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars
MODEL_PATH=./models/movement_model.pkl
SCALER_PATH=./models/scaler.pkl
CORS_ORIGINS=http://localhost:5173
DATA_SOURCE=simulation
SIMULATOR_DEVICE_ID=SIMULATOR-001
SIMULATOR_SAMPLE_RATE=100
SIMULATOR_SUBCARRIERS=64
SIMULATOR_NOISE_LEVEL=0.05
SIMULATOR_MOVEMENT_INTENSITY=1.0
TRAIN_AUTO_GENERATE=true